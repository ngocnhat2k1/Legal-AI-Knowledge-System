{
  "name": "customs-assistant",
  "version": "0.0.1",
  "description": "Customs Assistant — deterministic tariff lookup for a Vietnamese logistics company (v1)",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "yarn@4.17.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"db/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/apps/api/main.js",
    "test": "jest",
    "test:growth": "jest --runInBand --testRegex '\\.growth\\.spec\\.ts$'",
    "test:watch": "jest --watch",
    "test:bot": "node --test \"apps/zalo-bot/*.test.mjs\"",
    "test:parser": "python3 -m unittest discover -s research/legal-loader -p 'test_*.py' && python3 -m unittest discover -s research/fta-loader -p 'test_*.py' && python3 -m unittest discover -s research/inbox-loader -p 'test_*.py'",
    "eval": "tsx apps/eval/run.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed/index.ts",
    "db:seed:legal": "tsx db/seed/legal.ts",
    "gazette:index": "tsx apps/ingest/crawl-gazette.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zca-js": "^2.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "drizzle-kit": "^0.31.10",
    "jest": "^30.4.2",
    "prettier": "^3.9.5",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*(?<!\\.growth)\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/\\.claude/"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "apps/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
